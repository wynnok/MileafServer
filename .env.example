# Mileaf Cloud
MILEAF_ENV=dev
MILEAF_DATABASE_URL=postgresql+asyncpg://mileaf:mileaf@localhost:5432/mileaf
MILEAF_JWT_SECRET=replace-with-at-least-32-random-characters
MILEAF_AGENT_TOKEN_PEPPER=replace-with-another-random-secret
MILEAF_ACCESS_TOKEN_MINUTES=60
MILEAF_REFRESH_TOKEN_DAYS=30
MILEAF_PAIRING_CODE_MINUTES=15
MILEAF_AUTO_CREATE_TABLES=false
MILEAF_CORS_ORIGINS=*
MILEAF_LOG_LEVEL=INFO

# Mileaf Agent (deployed next to TeslaMate)
MILEAF_AGENT_TESLAMATE_DATABASE_URL=postgresql://teslamate:change-me@localhost:5432/teslamate
MILEAF_AGENT_MILEAF_URL=https://api.example.com
MILEAF_AGENT_PAIRING_CODE=
MILEAF_AGENT_AGENT_TOKEN=
MILEAF_AGENT_STATE_FILE=/data/agent-state.json
MILEAF_AGENT_INTERVAL_SECONDS=300
MILEAF_AGENT_BATCH_SIZE=200
MILEAF_AGENT_FULL_SYNC_INTERVAL_HOURS=24
MILEAF_AGENT_SOURCE_NAME=Home TeslaMate
MILEAF_AGENT_TESLAMATE_VERSION=
MILEAF_AGENT_LOG_LEVEL=INFO
