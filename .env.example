# Copy to your deployment environment. Mileaf Server reads only environment
# variables; it never reads a .env file from the image.

# Required. Read-only PostgreSQL DSN for the TeslaMate database.
MILEAF_DATABASE_DSN=postgresql://mileaf_reader:CHANGE_ME@teslamate-db:5432/teslamate

# Where the auth state file lives. Mount this directory as a volume.
MILEAF_STATE_FILE=/data/state.json

# host:port the HTTP server listens on.
MILEAF_LISTEN_ADDRESS=0.0.0.0:8080

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
MILEAF_LOG_LEVEL=INFO

# Upper bound on simultaneous database pool connections.
MILEAF_MAX_CONCURRENCY=4

# Lifetime of in-process aggregate caches, in seconds.
MILEAF_CACHE_TTL_SECONDS=60
